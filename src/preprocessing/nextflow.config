executor {
    cpus   = 32
    memory = '126 GB'
}

process {
    withName: SORT_INDEX {
        cpus   = 4
        memory = '16 GB'
    }
    withName: RUN_FLAGSTAT {
        cpus   = 2
        memory = '8 GB'
    }
    withName: MAKE_BEDS {
        cpus   = 8
        memory = '32 GB'
    }
    withName: MAKE_BEDGRAPHS {
        cpus   = 2
        memory = '8 GB'
    }
    withName: RUN_QC {
        cpus   = 2
        memory = '8 GB'
    }
}

profiles {
    conda { conda.enabled = true }
}

cleanup = true